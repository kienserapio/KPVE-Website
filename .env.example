# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres pooled connection string.
# Neon dashboard -> Connection Details -> Pooled connection
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# Signs the admin session cookie. Generate with: openssl rand -base64 32
# Rotating this invalidates every active session.
SESSION_SECRET=""

# Public site URL. http://localhost:3000 in dev.
NEXT_PUBLIC_APP_URL="https://kpve-website.vercel.app"

