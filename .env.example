# Copy to .env.local and fill in. NEVER put real values here — this file is
# committed to git. Real secrets live only in .env.local (gitignored) and in
# your host's env (Vercel → Settings → Environment Variables).
#
# The SAME six variables below are what you set in Vercel for production. Two of
# them differ between local and prod — see the notes.

# --- Required everywhere -----------------------------------------------------

# Neon Postgres pooled connection string.
# Neon dashboard -> Connection Details -> Pooled connection (the -pooler host).
# Must be set at BUILD time too, so add it in Vercel for all environments.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Signs the admin session cookie. Generate with: openssl rand -base64 32
# Rotating this signs out every active admin session.
SESSION_SECRET=""

# The origin the app is actually served from — every payment and invoice link is
# built from this. NO trailing slash.
#   local:  http://localhost:3000
#   Vercel: https://kpve.com   (set this value in Vercel, not the localhost one)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Payments (Stripe) -------------------------------------------------------
# With STRIPE_SECRET_KEY unset, payments run in SIMULATED mode: links point at an
# in-app checkout that runs the real flow (service goes active, bill date rolls,
# payment recorded) without moving money. Set the keys to switch to real Stripe —
# no code change.

# Stripe dashboard > Developers > API keys. sk_test_… until a real client pays.
STRIPE_SECRET_KEY=""

# Public key (safe to expose to the browser). Stripe dashboard > API keys.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# The webhook SIGNING secret — unique per endpoint, so LOCAL and PROD differ:
#   local:  run  stripe listen --api-key sk_test_… \
#                  --forward-to localhost:3000/api/stripe/webhook
#           (or `--print-secret`) — it prints a whsec_… for the CLI.
#   Vercel: Stripe dashboard > Developers > Webhooks > Add endpoint
#             URL:    https://kpve.com/api/stripe/webhook
#             events: checkout.session.completed, invoice.paid,
#                     invoice.payment_failed, customer.subscription.deleted
#           then open the endpoint and reveal its Signing secret (a DIFFERENT
#           whsec_… from the CLI one).
# Without this, links work but payments are never recorded — the Revenue page warns.
STRIPE_WEBHOOK_SECRET=""

# Forces the simulator back on with live keys still present — for demos.
# PAYMENTS_PROVIDER="mock"

# --- Not yet wired. Kept here so the shape is known when email lands. ---
# RESEND_API_KEY=""
# EMAIL_FROM="KPVE <support@kpve.com>"
# EMAIL_TO="support@kpve.com"
