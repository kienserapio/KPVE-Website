# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres pooled connection string.
# Neon dashboard -> Connection Details -> Pooled connection
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# Signs the admin session cookie. Generate with: openssl rand -base64 32
# Rotating this invalidates every active session.
SESSION_SECRET=""

# Public site URL. http://localhost:3000 in dev.
NEXT_PUBLIC_APP_URL="https://kpve-website.vercel.app"

# --- Payments ---------------------------------------------------------------
# With none of these set, payments run in SIMULATED mode: payment links point at
# an in-app checkout page that exercises the real flow (service goes active,
# bill date rolls, payment recorded) without moving money.
#
# To go live, set both. No code changes:
#   1. STRIPE_SECRET_KEY  — Stripe dashboard > Developers > API keys.
#                           sk_test_… until a real client pays.
#   2. STRIPE_WEBHOOK_SECRET — from the endpoint you register at
#                           <NEXT_PUBLIC_APP_URL>/api/stripe/webhook, subscribed
#                           to checkout.session.completed, invoice.paid,
#                           invoice.payment_failed and
#                           customer.subscription.deleted.
#                           Locally: stripe listen --forward-to \
#                             localhost:3000/api/stripe/webhook  (prints whsec_…)
#
# Setting the keys without the webhook secret means links work and payments are
# never recorded — the Revenue page warns when it sees that.
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# Forces the simulator back on with live keys still present — for demos.
# PAYMENTS_PROVIDER="mock"

# --- Not yet wired. Kept here so the shape is known when email lands. ---
# RESEND_API_KEY=""
# EMAIL_FROM="KPVE <noreply@kpve.com>"
# EMAIL_TO="info@kpve.com"
